# Nothing boot splash.
#
# Drawn from four solid-colour images scaled at runtime rather than from
# artwork, so it is sharp at any resolution and weighs a few hundred bytes in
# the initrd. A row of dots fills left to right while the machine boots.
#
# The password callback is not decoration: without it a machine with an
# encrypted disk shows a splash that never asks for the passphrase, and the
# boot stops there with no way forward.

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

DOT_COUNT  = 12;
DOT_SIZE   = 14;
DOT_GAP    = 10;

# ------------------------------------------------------------- background ---
background = Sprite(Image("black.png").Scale(screen_width, screen_height));
background.SetX(0);
background.SetY(0);
background.SetZ(-100);

# ------------------------------------------------------------------ label ---
# Ndot 57 if the initrd carries it, whatever fontconfig falls back to if not.
label_image  = Image.Text("fedora-nothing", 0.85, 0.85, 0.85, 1, "Ndot 57 22");
label_sprite = Sprite(label_image);
label_sprite.SetX((screen_width - label_image.GetWidth()) / 2);
label_sprite.SetY(screen_height * 0.42);
label_sprite.SetZ(10);

# ------------------------------------------------------------------- dots ---
dot_row_width = DOT_COUNT * DOT_SIZE + (DOT_COUNT - 1) * DOT_GAP;
dot_left      = (screen_width - dot_row_width) / 2;
dot_top       = screen_height * 0.53;

dot_off = Image("dot-off.png");
dot_on  = Image("dot-on.png");
accent  = Image("accent.png");

for (i = 0; i < DOT_COUNT; i++) {
  dots[i] = Sprite(dot_off);
  dots[i].SetX(dot_left + i * (DOT_SIZE + DOT_GAP));
  dots[i].SetY(dot_top);
  dots[i].SetZ(5);
}

# One dot lit, sweeping. Deliberately not a progress bar: boot progress is not
# knowable at this point, and a bar that stalls at 90% reads as a hang.
tick = 0;
fun refresh_callback() {
  tick++;
  head = Math.Int(tick / 4) % DOT_COUNT;
  for (i = 0; i < DOT_COUNT; i++) {
    if (i == head)
      dots[i].SetImage(accent);
    else if (i == (head + DOT_COUNT - 1) % DOT_COUNT)
      dots[i].SetImage(dot_on);
    else
      dots[i].SetImage(dot_off);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ------------------------------------------------------ password and text ---
# Shown for an encrypted disk. One dot per character typed, in the same row
# style as the animation above, so the splash never changes shape.
password.entered = 0;

fun display_password_callback(prompt_text, bullets) {
  password.entered = 1;
  for (i = 0; i < DOT_COUNT; i++)
    dots[i].SetOpacity(0);

  # prompt_text, not prompt: assigning fields onto the parameter would turn the
  # string it holds into a hash halfway through the function.
  ask_image  = Image.Text(prompt_text, 0.85, 0.85, 0.85, 1, "Ndot 57 18");
  ask_sprite = Sprite(ask_image);
  ask_sprite.SetX((screen_width - ask_image.GetWidth()) / 2);
  ask_sprite.SetY(dot_top - 8);
  ask_sprite.SetZ(20);
  password.prompt = ask_sprite;

  bullet_row = "";
  for (i = 0; i < bullets; i++)
    bullet_row = bullet_row + "*";     # no += in plymouth's script language
  entry_image  = Image.Text(bullet_row, 1, 1, 1, 1, "Ndot 57 22");
  entry_sprite = Sprite(entry_image);
  entry_sprite.SetX((screen_width - entry_image.GetWidth()) / 2);
  entry_sprite.SetY(dot_top + 34);
  entry_sprite.SetZ(20);
  password.entry = entry_sprite;
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  if (password.entered) {
    password.prompt = NULL;
    password.entry  = NULL;
    password.entered = 0;
    for (i = 0; i < DOT_COUNT; i++)
      dots[i].SetOpacity(1);
  }
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# Anything urgent enough for plymouth to say out loud, such as a failed
# passphrase, is shown rather than swallowed.
fun message_callback(text) {
  msg_image  = Image.Text(text, 0.7, 0.7, 0.7, 1, "Ndot 57 16");
  msg_sprite = Sprite(msg_image);
  msg_sprite.SetX((screen_width - msg_image.GetWidth()) / 2);
  msg_sprite.SetY(screen_height * 0.66);
  msg_sprite.SetZ(20);
  message.sprite = msg_sprite;
}
Plymouth.SetMessageFunction(message_callback);

# On the way down, the dots stop and the label stays until the screen goes.
fun quit_callback() {
  Plymouth.SetRefreshFunction(NULL);
}
Plymouth.SetQuitFunction(quit_callback);
