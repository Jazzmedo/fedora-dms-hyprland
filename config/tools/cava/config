# The pre-theme copy, in Nothing red. matugen overwrites this file with the
# live palette the first time the DMS theme changes; the template lives at
# config/theming/matugen/templates/cava-dms.
[general]
live-config = 1

[color]
# "default" keeps the terminal's own background, so the bars follow terminal
# transparency instead of painting their own backdrop.
background = default
foreground = '#d71921'

gradient = 1
gradient_color_1 = '#4c0d11'
gradient_color_2 = '#d71921'
gradient_color_3 = '#e14b52'
gradient_color_4 = '#f2f2f2'
