// Rewritten by matugen on every DMS theme change; edit this file, not the copy
// at ~/.config/fastfetch/config.jsonc.
//
// No frames and no section titles. Each row is a name, a nerd-font dot in
// the accent colour, then the value.  The dot echoes Nothing OS's
// dot-matrix motif, the same idea as the Ndot 57 shell font. Every key is padded by hand to the same
// character count, which is what keeps the chevrons in a straight column;
// fastfetch's own keyWidth aligns the value column instead and leaves the
// separator wherever the name happens to end.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // A water drop seen from above, Nothing dot-matrix style: the drop
        // and the first ripple in the theme accent ($1), the outer ripples
        // in the text colour ($2), the dots shrinking as the rings spread.
        // "$1"/"$2" are fastfetch's logo-file colour placeholders.
        "type": "file",
        "source": "~/.config/fastfetch/ripple-logo.txt",
        "padding": {
            // One blank line on top, like the info column. Below it the info
            // is 18 rows with one GPU and two disks, as tall as the ripple.
            "top": 1,
            "right": 3
        },
        "color": {
            "1": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
            "2": "38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}"
        }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "white" },
        "brightColor": false
    },
    "modules": [
        "break",
        { "type": "os", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{icon}  Linux    \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m" },
        { "type": "host", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{icon}  Laptop   \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m" },
        { "type": "kernel", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{icon}  Kernel   \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m" },
        { "type": "cpu", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{icon}  CPU      \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m" },
        { "type": "memory", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{icon}  RAM      \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m" },
        { "type": "gpu", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{icon}  GPU      \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m", "detectionMethod": "all" },
        { "type": "disk", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{icon}  Disk     \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m", "folders": ["/", "/home"], "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem} ({mountpoint})" },
        "break",
        { "type": "command", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m  Desktop  \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m", "text": "echo \"$(dms version | sed 's/^dms /DankMaterialShell /') (Quickshell $(qs --version | cut -d' ' -f2))\"" },
        { "type": "wm", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{icon}  Session  \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m" },
        { "type": "display", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{icon}  Display  \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m", "compactType": "original-with-refresh-rate" },
        "break",
        { "type": "terminal", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{icon}  Terminal \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m" },
        { "type": "packages", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{icon}  Packages \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m" },
        "break",
        { "type": "uptime", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{icon}  Uptime   \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m" },
        { "type": "disk", "key": "\u001b[38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}m{icon}  OS Age   \u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m\u001b[0m", "keyIcon": "󰃭", "folders": "/", "format": "{create-time:10} [{days} days]" }
    ]
}
