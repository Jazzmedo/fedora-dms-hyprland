# Regenerated by matugen on every DMS theme change; the pre-theme copy in the
# repo (config/tools/cava/config) holds the stock Nothing-red colours until a
# theme lands. live-config=1 makes a running cava pick new colours up by
# itself when this file is rewritten.
[general]
live-config = 1

[color]
# "default" keeps the terminal's own background, so the bars follow terminal
# transparency instead of painting their own backdrop.
background = default
foreground = '{{colors.primary.default.hex}}'

gradient = 1
gradient_color_1 = '{{colors.primary_container.default.hex}}'
gradient_color_2 = '{{colors.primary.default.hex}}'
gradient_color_3 = '{{colors.secondary.default.hex}}'
gradient_color_4 = '{{colors.tertiary.default.hex}}'
