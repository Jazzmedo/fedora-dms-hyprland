[Unit]
Description=Dank Material Shell (DMS) for Niri and Hyprland
After=dbus.socket
# niri starts this through graphical-session.target. Without the ordering it
# launched alongside niri, before there was a display to connect to, failed
# five times in a few seconds, hit systemd's start limit and left niri on a
# black screen. Hyprland starts it itself once running, so this is a no-op there.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
Environment="PATH=@@HOME@@/.local/lib/dms-wrappers:@@HOME@@/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecCondition=/bin/sh -c '/usr/bin/pgrep -x niri >/dev/null || /usr/bin/pgrep -x Hyprland >/dev/null'
ExecStartPre=-/usr/bin/qdbus6 org.kde.kded6 /kded org.kde.kded6.loadModule statusnotifierwatcher
ExecStart=/usr/bin/dms run --session
ExecReload=/usr/bin/pkill -USR1 -x dms
Restart=on-failure
RestartSec=1.23
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
