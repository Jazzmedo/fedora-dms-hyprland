binds {
    Mod+Ctrl+Q hotkey-overlay-title="Toggle AutoHide Bar" { spawn "dms" "ipc" "call" "bar" "toggleAutoHide" "index" "0"; }
    Mod+Ctrl+Shift+Q hotkey-overlay-title="Toggle Bar" { spawn "dms" "ipc" "call" "bar" "toggle" "index" "0"; }
    Mod+space hotkey-overlay-title="Run an Application: DMS Spotlight" { spawn-sh "dms ipc call spotlight toggle"; }
    Print hotkey-overlay-title="Screenshot: Interactive" { spawn "dms" "ipc" "call" "niri" "screenshot"; }
    Mod+A { focus-column-left; }
    Mod+BracketRight hotkey-overlay-title="Expand to Available Width" { expand-column-to-available-width; }
    Mod+Shift+X hotkey-overlay-title="Move Up" { move-window-up; }
    Mod+X hotkey-overlay-title="Consume/Expel Right" { consume-or-expel-window-right; }
    Mod+E hotkey-overlay-title="Files: Dolphin" { spawn "dolphin"; }
    Mod+Return hotkey-overlay-title="Kitty" { spawn "kitty"; }
    Mod+Shift+Return hotkey-overlay-title="Open a Terminal: alacritty" { spawn "alacritty"; }
}
