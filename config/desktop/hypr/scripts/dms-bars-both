#!/usr/bin/env bash
# Show/hide or auto-hide every Dank Bar together. Toggling each bar on its own
# flips them in opposite directions once they disagree, so the main bar's
# state picks one target and every bar is set to it.
set -u

settings="${XDG_CONFIG_HOME:-$HOME/.config}/DankMaterialShell/settings.json"
count=$(jq '.barConfigs | length' "$settings") || exit 1

case "${1:-}" in
  visibility)
    [[ $(dms ipc call bar status index 0) == visible ]] && command=hide || command=reveal
    ;;
  auto-hide)
    [[ $(jq '.barConfigs[0].autoHide' "$settings") == true ]] && command=manualHide || command=autoHide
    ;;
  *)
    exit 2
    ;;
esac

for ((i = 0; i < count; i++)); do
  dms ipc call bar "$command" index "$i" >/dev/null
done
