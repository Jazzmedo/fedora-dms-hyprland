#!/usr/bin/env bash
set -u

settings="$HOME/.config/DankMaterialShell/settings.json"
base="$HOME/Pictures/Wallpapers/theme-collections"
lock="$XDG_RUNTIME_DIR/dms-theme-wallpapers.lock"

# Everything printed here lands in the journal:
#   journalctl --user -u dms-theme-wallpapers -n 40
# A wallpaper that does not follow the theme is otherwise completely silent.
log() { printf 'dms-theme-wallpapers: %s\n' "$*" >&2; }

exec 9>"$lock"
flock -n 9 || exit 0

# DMS saves several theme fields in quick succession. Read after they settle.
sleep 0.6
[[ -d "$base" ]] || exit 0

category="$(jq -r '.currentThemeCategory // ""' "$settings" 2>/dev/null)"
name="$(jq -r '.currentThemeName // ""' "$settings" 2>/dev/null)"
theme_file="$(jq -r '.customThemeFile // ""' "$settings" 2>/dev/null)"

# Match wallpaper folders to installed DMS themes without maintaining a list.
# Folder names are compared as lowercase slugs, so theme directories such as
# `steamDeck` and `deep_sage` match `steam-deck` and `deep-sage`.
slugify() {
  printf '%s' "$1" \
    | sed -E 's/([a-z0-9])([A-Z])/\1-\2/g' \
    | tr '[:upper:]_' '[:lower:]-' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-+/-/g'
}

# Which theme is selected. A theme picked from the DMS registry is named
# directly in settings.json and never touches customThemeFile, so reading that
# file alone missed every registry switch.
if [[ -n "$name" && "$name" != "custom" ]]; then
  theme_id="$name"
  theme_name="$name"
else
  if [[ ! -f "$theme_file" ]]; then
    log "no theme selected: currentThemeName is '$name' and customThemeFile is '$theme_file'"
    exit 0
  fi
  theme_id="$(basename "$(dirname "$theme_file")")"
  theme_name="$(jq -r '.name // ""' "$theme_file" 2>/dev/null)"
fi

theme_slug="$(slugify "$theme_id")"
name_slug="$(slugify "$theme_name")"
collection=""

# There is no record of the last theme applied any more.
#
# Wallpaper changes rewrite settings.json and so retrigger this service, and a
# remembered theme was how that loop was broken. It also broke everything
# else: any run that recorded a theme and then failed to reach a monitor made
# every later attempt exit before doing anything, and the desktop picture
# stopped following the theme until the state file was deleted by hand.
#
# The per-output check below already ends the loop. A second run finds the
# right image on every screen, writes nothing, and stops there.
#
# The desktop shell is started in the same chain that starts this script, so
# on a fresh login it is usually not answering yet. Waiting is the difference
# between a wallpaper appearing and this quietly giving up.
wait_for_dms() {
  local waited=0
  while (( waited < 30 )); do
    dms ipc call wallpaper get >/dev/null 2>&1 && return 0
    # An error reply still proves the shell is up and listening.
    dms ipc call wallpaper getFor _probe >/dev/null 2>&1 && return 0
    sleep 1
    waited=$(( waited + 1 ))
  done
  return 1
}

if ! wait_for_dms; then
  log "the desktop shell never answered; giving up"
  exit 1
fi

while IFS= read -r -d '' candidate; do
  candidate_slug="$(slugify "$(basename "$candidate")")"
  if [[ "$candidate_slug" == "$theme_slug" || \
        ( -n "$name_slug" && "$candidate_slug" == "$name_slug" ) || \
        "$candidate_slug" == "$theme_slug-"* || \
        ( -n "$name_slug" && "$candidate_slug" == "$name_slug-"* ) ]]; then
    collection="$candidate"
    break
  fi
done < <(find -L "$base" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)

# A theme with no matching folder should not disturb the current wallpapers.
if [[ -z "$collection" ]]; then
  log "no wallpaper collection for theme '$theme_id' (looked for '$theme_slug' or '$name_slug' in $base)"
  exit 0
fi
log "theme '$theme_id' -> $(basename "$collection")"

list_images() {
  find -L "$1" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \
       -o -iname '*.bmp' -o -iname '*.avif' -o -iname '*.jxl' \) 2>/dev/null | sort
}

is_portrait() {
  local dim w h
  dim="$(identify -format '%w %h' "$1[0]" 2>/dev/null)" || return 1
  [[ -n "$dim" ]] || return 1
  w="${dim% *}"
  h="${dim#* }"
  (( h > w ))
}

horizontal="$(list_images "$collection/horizontal" | head -n 1)"
vertical="$(list_images "$collection/vertical" | head -n 1)"

# A collection dropped in for a freshly installed theme usually has no
# horizontal/vertical split, so sort loose images by their own orientation.
if [[ -z "$horizontal" || -z "$vertical" ]]; then
  while IFS= read -r image; do
    [[ -n "$image" ]] || continue
    if is_portrait "$image"; then
      [[ -n "$vertical" ]] || vertical="$image"
    else
      [[ -n "$horizontal" ]] || horizontal="$image"
    fi
  done < <(list_images "$collection")
fi

# A collection may hold only one orientation. Putting the same image on both
# monitors still follows the theme, which beats leaving the old wallpaper.
[[ -n "$horizontal" ]] || horizontal="$vertical"
[[ -n "$vertical" ]] || vertical="$horizontal"
[[ -n "$horizontal" ]] || exit 0

# Wallpaper writes update DMS settings and regenerate Matugen colors. Since
# this service watches the settings file, only write when the selected file is
# genuinely different; the resulting follow-up event then becomes a no-op.
# Apply to every connected output rather than the two this config was first
# written for. Portrait monitors get the vertical image where one exists.
mapfile -t outputs < <(hyprctl monitors -j 2>/dev/null \
  | jq -r '.[] | "\(.name) \(.width) \(.height) \(.transform)"' 2>/dev/null)

if [[ ${#outputs[@]} -eq 0 ]]; then
  outputs=("@@MONITOR@@ 1920 1080 0")
fi

applied=0
for spec in "${outputs[@]}"; do
  read -r name width height transform <<<"$spec"
  # Transforms 1 and 3 are the 90/270-degree rotations, which swap the axes.
  if (( transform == 1 || transform == 3 )); then
    (( width < height )) || { tmp=$width; width=$height; height=$tmp; }
  fi
  if (( height > width )); then
    wanted="$vertical"
  else
    wanted="$horizontal"
  fi
  [[ -n "$wanted" ]] || continue
  current="$(dms ipc call wallpaper getFor "$name" 2>/dev/null || true)"
  [[ "$current" == "$wanted" ]] && { applied=$((applied + 1)); continue; }
  # Reported rather than swallowed: if a DMS release renames this call, the
  # only symptom is a wallpaper that quietly stops following the theme.
  if err="$(dms ipc call wallpaper setFor "$name" "$wanted" 2>&1 >/dev/null)"; then
    applied=$((applied + 1))
  elif err2="$(dms ipc call wallpaper set "$wanted" 2>&1 >/dev/null)"; then
    # Older and single-output builds take the path without a monitor name.
    applied=$((applied + 1))
  else
    log "could not set $wanted on $name: $err / $err2"
  fi
done

# Nothing applied means the theme must not stay recorded, or the guard above
# turns a transient failure into a permanent one.
log "applied $applied of ${#outputs[@]} outputs from $(basename "$collection")"

if (( applied == 0 )); then
  log "no wallpaper applied; will retry"
  exit 1
fi
