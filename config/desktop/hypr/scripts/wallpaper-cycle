#!/usr/bin/env bash
# Cycle the wallpaper everywhere at once: the session runs one global
# wallpaper, so both monitors move together. The per-monitor call stays
# as a fallback for a session with per-monitor wallpapers enabled again.
set -u

action="${1:-next}"

case "$action" in
  next|prev) ;;
  *) exit 2 ;;
esac

if ! dms ipc call wallpaper "$action" >/dev/null 2>&1; then
  monitor="$(hyprctl -j monitors | jq -r 'first(.[] | select(.focused) | .name) // empty')"
  [ -n "$monitor" ] && dms ipc call wallpaper "${action}For" "$monitor" >/dev/null
fi
